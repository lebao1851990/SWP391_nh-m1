# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=codeassess
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password_here

# Alternative: TiDB Cloud Configuration
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_NAME=codeassess
# DB_USERNAME=your_tidb_username
# DB_PASSWORD=your_tidb_password
# DB_USE_SSL=true
# DB_SSL_MODE=VERIFY_IDENTITY

# Server Configuration
PORT=8081

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_must_be_at_least_256_bits
JWT_EXPIRATION_MS=86400000

# AI Provider Configuration (Gemini / Fallback)
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=your_fallback_ai_api_key_here

# BullMQ / Queue Configuration
BULLMQ_PRODUCER_URL=http://localhost:3001
INTERNAL_API_SECRET=codeassess-internal-secret-2026
REDIS_HOST=localhost
REDIS_PORT=6379
