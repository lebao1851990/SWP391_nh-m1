# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=plagiarism_system
DB_USERNAME=root
DB_PASSWORD=123456

# Server Configuration
PORT=8081

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000

# AI Configuration (Gemini)
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
# Code supports GEMINI_API_KEY (preferred) or AI_API_KEY (fallback)
GEMINI_API_KEY=<khoá API Gemini cá nhân hoặc nhóm>
AI_API_KEY=<fallback AI API key nếu không dùng GEMINI_API_KEY>

# Google OAuth Configuration (Chuẩn bị cho giai đoạn tích hợp)
GOOGLE_CLIENT_ID=<lấy từ Google Cloud Console của nhóm>
GOOGLE_CLIENT_SECRET=<lấy từ Google Cloud Console của nhóm>

# Mail Configuration (Gmail SMTP - Chuẩn bị cho giai đoạn tích hợp)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<email gửi thư của nhóm>
MAIL_PASSWORD=<Gmail App Password>
MAIL_FROM=<email gửi thư của nhóm>