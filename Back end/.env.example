# ==============================================================================
# Database Configuration (MySQL / TiDB Cloud)
# ==============================================================================
# Local MySQL (Default)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=codeassess
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password_here

# Alternative: TiDB Cloud Serverless Configuration
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_NAME=codeassess
# DB_USERNAME=your_tidb_username_here
# DB_PASSWORD=your_tidb_password_here
# DB_USE_SSL=true
# DB_SSL_MODE=VERIFY_IDENTITY

# ==============================================================================
# Server & CORS Configuration
# ==============================================================================
PORT=8081
ALLOWED_ORIGINS=http://localhost:3000

# ==============================================================================
# Security & JWT Configuration
# ==============================================================================
JWT_SECRET=your_jwt_secret_key_here_must_be_at_least_256_bits
JWT_EXPIRATION_MS=86400000

# Internal Worker Authentication (Must match bullmq-service INTERNAL_API_SECRET)
INTERNAL_API_SECRET=your_internal_api_secret_here_must_be_random_256_bits

# ==============================================================================
# AI Provider Configuration (Gemini / Fallback)
# ==============================================================================
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
# Code supports GEMINI_API_KEY (preferred) or AI_API_KEY (fallback)
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=your_fallback_ai_api_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ==============================================================================
# Mail Configuration (Gmail SMTP)
# ==============================================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here
MAIL_FROM=your_email@gmail.com

# ==============================================================================
# BullMQ & Redis Queue Configuration
# ==============================================================================
BULLMQ_PRODUCER_URL=http://localhost:3001
REDIS_HOST=localhost
REDIS_PORT=6379
