# =============================================================================
# CodeAssess Platform — Environment Configuration Template
# Copy this file to '.env' before running 'docker compose up -d'
# =============================================================================

# --- Database (Default: Docker Local MySQL 8.0) ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=codeassess
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password_here
DB_USE_SSL=false
DB_SSL_MODE=PREFERRED

# --- Alternative: TiDB Cloud Configuration ---
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_NAME=<confirmed-database-name>
# DB_USERNAME=<your_tidb_username>
# DB_PASSWORD=<new-rotated-password>
# DB_USE_SSL=true
# DB_SSL_MODE=VERIFY_IDENTITY

# --- Redis & Worker ---
REDIS_PORT=6379
INTERNAL_API_SECRET=codeassess-internal-secret-2026
BULLMQ_CONCURRENCY=2

# --- Ports ---
PORT=8081
FRONTEND_PORT=3000
MYSQL_HOST_PORT=3307

# --- AI Providers (Optional: Gemini / OpenAI) ---
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=your_fallback_ai_api_key_here

