# Backend URL for Next.js server-side rewrites (Reverse Proxy)
# Development (Local Docker / Spring Boot):
# BACKEND_URL=http://localhost:8081
# Production (Render Cloud Backend):
BACKEND_URL=https://codeassess-backend.onrender.com

# Client API base URL (defaults to /api which routes through Next.js reverse proxy)
NEXT_PUBLIC_API_URL=/api
